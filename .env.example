# ---- Supabase (admin dashboard, properties, inquiries) ----
# From Supabase: Project Settings -> API. Leave blank to run the public site from the built-in seed data only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Used once by `npm run seed` to create the first admin login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- Inquiry forwarding (optional) ----
# When set, every inquiry is also POSTed to this URL after being saved to Supabase.
INQUIRY_FORWARD_URL=https://stlc-backend.onrender.com/api/v1/inquiry/property
INQUIRY_FORWARD_KEY=

# ---- Booking emails (optional) ----
# With a Resend API key, booking requests email the team and the guest. Without it, requests are still saved in the admin.
RESEND_API_KEY=
EMAIL_FROM=Stealth Land Corp <reservations@stealthlandcorp.com>
BOOKING_NOTIFY_EMAIL=admin@stealthlandcorp.com
